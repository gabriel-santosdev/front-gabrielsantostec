# Chave gratuita do Google AI Studio: https://aistudio.google.com/apikey
# Usada pelo terminal com IA do hero (server/api/ask.post.ts).
GEMINI_API_KEY=

# Opcional: troca o modelo do Gemini (padrão: gemini-3.8-flash)
# GEMINI_MODEL=

# URL pública do site (ex.: https://seudominio.com), usada nas tags hreflang/canonical dos idiomas
# NUXT_PUBLIC_SITE_URL=

# Opcional: outras origens autorizadas a chamar /api/ask, separadas por vírgula (ex.: URL de preview)
# AI_ALLOWED_ORIGINS=

# Opcional: marcador secreto usado para detectar vazamento do prompt da IA
# AI_CANARY=
